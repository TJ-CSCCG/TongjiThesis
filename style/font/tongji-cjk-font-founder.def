\ProvidesFile{tongji-cjk-font-founder.def}[v1.5.1 Founder CJK fonts definition (TongjiThesis)] %x-release-please-version
% 方正书宋、黑体、楷体、仿宋（方正网站可免费下载，供“发布使用”）。文件在 fontdir 中时从那里加载。
\tj@cjkfonts
  {FZShuSong-Z01}{FZSSK.TTF}
  {FZHei-B01}{FZHTK.TTF}
  {FZKai-Z03}{FZKTK.TTF}
  {FZFangSong-Z02}{FZFSK.TTF}
\tj@cjkfamily{zhli}{FZLiShu-S01}{FZLSK.TTF}
\tj@cjkfamily{zhyou}{FZXiYuan-M01}{FZY1K.TTF}

% 以下定义体内不要加空格：本文件按普通 catcode 读入，空格会排进正文（标题、目录会因此缩进）。
\NewDocumentCommand{\lishu}    {} {\CJKfamily{zhli}}
\NewDocumentCommand{\youyuan}  {} {\CJKfamily{zhyou}}
\endinput
