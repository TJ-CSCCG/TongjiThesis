\ProvidesFile{tongji-cjk-font-fandol.def}[v1.5.1 Fandol CJK fonts definition (TongjiThesis)] %x-release-please-version
% Fandol 宋体、黑体、楷体、仿宋，宋体与黑体有真粗体。随旧版 TeX Live 与 Overleaf 安装（作者已撤回）；
% 文件在 fontdir 中时从那里加载。
\IfFileExists{\tongjithesis@fontdir FandolSong-Regular.otf}
  {\edef\tj@cjkpath{Path=\tongjithesis@fontdir,}}
  {\def\tj@cjkpath{}}
\def\tj@fandolsong{\tj@cjkpath Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=FandolKai-Regular}
\def\tj@fandolhei{\tj@cjkpath Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold}
\def\tj@fandolregular{\tj@cjkpath Extension=.otf,UprightFont=*-Regular}
\tj@cjkload\setCJKmainfont{FandolSong}{\tj@fandolsong}
\tj@cjkload\setCJKsansfont{FandolHei}{\tj@fandolhei}
\tj@cjkload\setCJKmonofont{FandolFang}{\tj@fandolregular}

\tj@cjkload{\setCJKfamilyfont{zhsong}}{FandolSong}{\tj@fandolsong}
\tj@cjkload{\setCJKfamilyfont{zhhei}}{FandolHei}{\tj@fandolhei}
\tj@cjkload{\setCJKfamilyfont{zhkai}}{FandolKai}{\tj@fandolregular}
\tj@cjkload{\setCJKfamilyfont{zhfs}}{FandolFang}{\tj@fandolregular}

% 以下定义体内不要加空格：本文件按普通 catcode 读入，空格会排进正文（标题、目录会因此缩进）。
\NewDocumentCommand{\songti}   {} {\CJKfamily{zhsong}}
\NewDocumentCommand{\heiti}    {} {\CJKfamily{zhhei}}
\NewDocumentCommand{\kaishu}   {} {\CJKfamily{zhkai}}
\NewDocumentCommand{\fangsong} {} {\CJKfamily{zhfs}}
\endinput
