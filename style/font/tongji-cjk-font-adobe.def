\ProvidesFile{tongji-cjk-font-adobe.def}[v1.5.1 Adobe CJK fonts definition (TongjiThesis)] %x-release-please-version
% Adobe 宋体、黑体、楷体、仿宋 Std（随旧版 Adobe Reader 安装）。文件在 fontdir 中时从那里加载。
\tj@cjkfonts
  {AdobeSongStd-Light}{AdobeSongStd-Light.otf}
  {AdobeHeitiStd-Regular}{AdobeHeitiStd-Regular.otf}
  {AdobeKaitiStd-Regular}{AdobeKaitiStd-Regular.otf}
  {AdobeFangsongStd-Regular}{AdobeFangsongStd-Regular.otf}
\endinput
