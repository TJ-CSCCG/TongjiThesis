\ProvidesFile{tongji-cjk-font-windows.def}[v1.6.0 Windows CJK fonts definition (TongjiThesis)] %x-release-please-version
% 中易字体（Windows 自带），即 Word 模板所用字体。文件在 fontdir 中时从那里加载。
\tj@cjkfonts
  {SimSun}{simsun.ttc}
  {SimHei}{simhei.ttf}
  {KaiTi}{simkai.ttf}
  {FangSong}{simfang.ttf}
\tj@cjkfamily{zhli}{LiSu}{simli.ttf}
\tj@cjkfamily{zhyou}{YouYuan}{simyou.ttf}
\tj@cjkfamily{zhyahei}{Microsoft YaHei}{msyh.ttc}[BoldFont=* Bold][BoldFont=msyhbd.ttc]

% 以下定义体内不要加空格：本文件按普通 catcode 读入，空格会排进正文（标题、目录会因此缩进）。
\NewDocumentCommand{\lishu}    {} {\CJKfamily{zhli}}
\NewDocumentCommand{\youyuan}  {} {\CJKfamily{zhyou}}
\NewDocumentCommand{\yahei}    {} {\CJKfamily{zhyahei}}
\endinput
